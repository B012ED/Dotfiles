{
    "custom/power-button": {
        "format": "",
        "tooltip": false,
        "on-click": "exec $HOME/.config/myth/yupower.sh"
    },
    "custom/clients": {
        "exec": "/home/yusa/.config/yusa/yuclient.sh",
        "format": "{}",
        "interval": 1,
        "escape": false,
        "tooltip": false
    },
    "disk": {
        "interval": 30,
        "format": "󰋊  | {percentage_used}% ",
        "on-click": "bash ~/.config/myth/yuhtop.sh"
    },
    "custom/yusa": {
        "exec": "/home/yusa/.config/myth/yusabi.sh",
        "format": "{}",
        "interval": 30,
        "tooltip": false
    },
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "{:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#787a81'><b>{}</b></span>",
                "days": "<span color='#bec0c9'><b>{}</b></span>",
                "weeks": "<span color='#b85504'><b>{}</b></span>"
            }
        }
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "bash ~/.config/myth/yubtop.sh"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format": "{auto}",
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "   {ifname}",
        "format-disconnected": "Disconnected ⚠",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": " {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": "   {ifname}\nIP: {ipaddr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "~/.config/yusa/yunm-applet.sh toggle",
        "on-click-right": "~/.config/yusa/yunm-applet.sh toggle"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "memory": {
        "format": " 󰓅  | {}% ",
        "on-click": "bash ~/.config/myth/yuhtop.sh"
    },
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 700,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": [
            "temperature",
            "disk",
            "cpu",
            "memory"
        ]
    },
    "group/yusa": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 700,
            "children-class": "not-memory",
            "transition-right-to-left": false
        },
        "modules": [
            "custom/yusa",
            "pulseaudio",
            "network",
            "custom/updown_speed",
            "power-profiles-daemon"
        ]
    },
    "custom/myth": {
        "exec": "/home/yusa/.config/myth/yumyth.sh",
        "format": "{}",
        "interval": 30,
        "tooltip-format": "Wallpaper",
        "tooltip": true,
        "on-click": "~/.config/myth/yulaunch.sh"
    },
    "cpu": {
        "format": " 󰍛  | {usage}% ",
        "on-click": "bash ~/.config/myth/yuhtop.sh",
        "class": "large-icon"
    },
    "custom/swaync": {
        "exec": "/home/yusa/.config/yusa/yusa.sh",
        "interval": 5,
        "format": "{}",
        "format-icons": {
            "enabled": "󰂚",
            "disabled": "󰂛",
            "none": "󰂛",
            "dnd": "󰂛"      
        },
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -D",
        "on-click-middle": "swaync-client -C"
    },
    "tray": {
        "spacing": 10,
        "icon-size": 20
    },
    "group/myth": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 700,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": [
            "clock",
            "custom/myth"
        ]
    }
}