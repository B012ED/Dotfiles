{
    
    "custom/power-button": {
        "format": "",
        "tooltip": false,
        "on-click": "exec $HOME/.config/yusa/yupower.sh"
    },
    "custom/clients": {
        "exec": "bash -c 'hyprctl clients -j | jq -r \".[].class\" | sort -u | while read -r app; do case \"$app\" in app.zen_browser.zen) echo -n \" \";; spotify) echo -n \" \";; code|Code|code-oss) echo -n \" \";; kitty|Alacritty) echo -n \" \";; thunar) echo -n \" \";; chromium|chrome) echo -n \" \";; *) echo -n \" \";; esac; done; echo'",
        "interval": 2,
        "format": "{}",
        "escape": false,
        "tooltip": false
    },

    "custom/yusa": {
        "format": "<span rise='-1000'>󰣇</span>",
        "tooltip": false
    },

    "clock": {
        "format": "<span rise='-500'>  </span>{:%a %d %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "bash ~/.config/yusa/yubtop.sh"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                "",
                " "
            ]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format": "{auto}",
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "   {ifname}",
        "format-disconnected": "Disconnected ⚠",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": " {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": "   {ifname}\nIP: {ipaddr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "~/.config/yusa/yunm-applet.sh toggle",
        "on-click-right": "~/.config/yusa/yunm-applet.sh toggle"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
            }
    },
    "tray": {
        "spacing": 10,
        "icon-size": 20
    },

    "cpu": {
        "format": " 󰍛 | {usage}% ",
        "on-click": "bash ~/.config/yusa/yuhtop.sh"
    },

    "memory": {
        "format": " 󰓅 | {}% ",
        "on-click": "bash ~/.config/yusa/yuhtop.sh"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 | {percentage_used}% ",
        "on-click": "bash ~/.config/yusa/yuhtop.sh"
    },

    "group/hardware": {
    "orientation": "inherit",
    "drawer": {
        "transition-duration": 700,
        "children-class": "not-memory",
        "transition-left-to-right": false
         },
    "modules": [
        "temperature",
        "disk",
        "cpu",
        "memory"
        ]

    },
    "group/yusa": {
    "orientation": "inherit",
    "drawer": {
        "transition-duration": 700,
        "children-class": "not-memory",
        "transition-right-to-left": true
         },
    "modules": [
        "custom/yusa",
        "pulseaudio",
        "network",
        "power-profiles-daemon"
        ]

    },
    "custom/myth": {
        "format": "<span rise='-1000'></span>",
        "tooltip": false,
        "on-click": "exec $HOME/.config/yusa/yulaunch.sh"

    },
    "custom/sway": {
    "format": "<span rise='-1000'>󰂚</span>",
    "tooltip": false

    },
    "group/myth": {
    "orientation": "inherit",
    "drawer": {
        "transition-duration": 700,
        "children-class": "not-memory",
        "transition-left-to-right": false
         },
    "modules": [
        "custom/sway",
        "custom/myth"
        ]
    }

    
}